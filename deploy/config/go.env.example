# Public Go service runtime configuration.
# Copy this file to the ignored go.development.env, go.staging.env, or
# go.production.env sibling before starting the service. Do not commit a copy.
# Production secrets must be injected from a managed secret store; an ignored
# file is only a local/development convenience, never the production secret system.
APP_ENV=development-placeholder
APP_LISTEN_ADDR=:8080
APP_SESSION_SECRET=replace-at-runtime-not-a-secret
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=public-anon-key-placeholder-not-a-secret
SUPABASE_JWT_ISSUER=https://example.supabase.co/auth/v1
RUST_SERVICE_URL=http://rust-service:8080
RUST_SERVICE_TOKEN=replace-at-runtime-not-a-secret
