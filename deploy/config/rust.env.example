# Private Rust service runtime configuration. Compose attaches this listener
# only to the private network; never publish it with a host ports mapping.
# Copy this file to the ignored rust.development.env, rust.staging.env, or
# rust.production.env sibling before starting the service. Do not commit a copy.
# Production secrets must be injected from a managed secret store; an ignored
# file is only a local/development convenience, never the production secret system.
RUST_LISTEN_ADDR=:8080
RUST_SERVICE_TOKEN=replace-at-runtime-not-a-secret
