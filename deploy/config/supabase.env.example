# Supabase runtime configuration.
# Copy this file to the ignored supabase.development.env, supabase.staging.env,
# or supabase.production.env sibling before running backend tooling. Do not commit a copy.
# SUPABASE_URL and SUPABASE_ANON_KEY are public client configuration. The
# service-role value is backend-only and must never be rendered or bundled.
# Production secrets must be injected from a managed secret store; an ignored
# file is only a local/development convenience, never the production secret system.
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=public-anon-key-placeholder-not-a-secret
SUPABASE_SERVICE_ROLE_KEY=replace-from-managed-secret-store
