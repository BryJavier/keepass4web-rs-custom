{
    "name": "KeePass4Web",
    "version": "1.0.0",
    "description": "Web KeePass application",
    "scripts": {
        "test": "playwright test --reporter=list",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed --reporter=list",
        "build:css": "tailwindcss -i ./frontend/web/tailwind.input.css -o ./frontend/web/static/tailwind.css --minify"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lixmal/keepass4web-rs"
    },
    "keywords": [
        "keepass"
    ],
    "author": "Viktor Liu",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/lixmal/keepass4web-rs/issues"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "tailwindcss": "^3.4.17"
    },
    "dependencies": {
        "htmx.org": "2.0.4"
    }
}
